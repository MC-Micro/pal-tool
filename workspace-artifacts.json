{
  "schemaVersion": 1,
  "profiles": {
    "passive-reference-approved-schema2": {
      "description": "Exact approved Schema-2 evidence used to publish the canonical passive reference space.",
      "localDirectory": "passive-reference-approved-schema2",
      "provenanceSources": [
        {
          "type": "json",
          "path": "data/palworld-core/passives.approval.json",
          "map": {
            "repository": "/provenance/repository",
            "workflow": "/provenance/workflow",
            "workflowRunId": "/provenance/workflowRunId",
            "repositoryHead": "/provenance/commitSha",
            "artifactName": "/provenance/artifactName",
            "artifactId": "/provenance/artifactId",
            "artifactSha256": "/provenance/artifactSha256",
            "steamBuildId": "/sourceReview/steamBuildId",
            "sourceReviewSchemaVersion": "/sourceReview/schemaVersion",
            "technicalCandidateSha256": "/sourceReview/technicalCandidateSha256",
            "referenceSpaceSha256": "/sourceReview/referenceSpaceSha256"
          }
        }
      ],
      "expectedFiles": [
        "breeding-review.json",
        "core-inventory-a.json",
        "core-snapshot-a.json",
        "core-summary-a.json",
        "passive-candidate-a.json",
        "passive-review.json",
        "passive-summary-a.json"
      ],
      "contentChecks": [
        {
          "type": "sha256",
          "path": "passive-candidate-a.json",
          "expected": { "provenanceField": "technicalCandidateSha256" }
        },
        {
          "type": "json_equals",
          "path": "passive-review.json",
          "pointer": "/schemaVersion",
          "expected": { "provenanceField": "sourceReviewSchemaVersion" }
        },
        {
          "type": "json_equals",
          "path": "passive-review.json",
          "pointer": "/steamBuildId",
          "expected": { "provenanceField": "steamBuildId" }
        },
        {
          "type": "json_equals",
          "path": "passive-review.json",
          "pointer": "/passiveDataset/technicalCandidateSha256",
          "expected": { "provenanceField": "technicalCandidateSha256" }
        },
        {
          "type": "json_equals",
          "path": "passive-review.json",
          "pointer": "/passiveDataset/referenceSpaceSha256",
          "expected": { "provenanceField": "referenceSpaceSha256" }
        },
        {
          "type": "json_equals",
          "path": "passive-review.json",
          "pointer": "/ok",
          "expected": { "literal": true }
        }
      ]
    },
    "pal-data-core-resolver-head-evidence": {
